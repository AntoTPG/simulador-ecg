  "author": "Antonio Requena Quesada",
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.1.0",
  "description": "Simulador educativo 3D del vector cardíaco y del ECG de 12 derivaciones",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "licencias": "node scripts/licencias.mjs",
    "prebuild": "node scripts/licencias.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.9"
    }
  },
  "engines": {
    "node": ">=20.19"
  }
